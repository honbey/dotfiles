[Unit]
Description=MCP SearXNG container service

After=searxng.service
Requires=searxng.service

StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
Image=docker.io/isokoliuk/mcp-searxng:latest

ContainerName=mcp-searxng

#StopSignal=SIGINT
StopTimeout=10

EnvironmentFile=%h/.config/containers/systemd/mcp-searxng.env

User=1000:1000

PublishPort=127.0.0.1:1129:3000

Network=10_26_0_1.network:ip=10.26.11.29

PodmanArgs=--cpus=0.5
PodmanArgs=--memory=256m
PodmanArgs=--memory-reservation=16m

LogDriver=journald

HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/health
HealthStartPeriod=10s
HealthInterval=60s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
