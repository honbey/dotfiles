[Unit]
Description=Tuwunel (Matrix Server) container service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
Image=docker.io/jevolk/tuwunel:main

ContainerName=tuwunel

Exec=--config /etc/tuwunel/config.toml

StopTimeout=10

EnvironmentFile=%h/.config/containers/systemd/tuwunel.env

Volume=./tuwunel.conf.d:/etc/tuwunel:Z
Volume=tuwunel_data.volume:/var/lib/tuwunel:Z

PublishPort=127.0.0.1:1110:8008

Network=10_26_0_1.network:ip=10.26.11.10

PodmanArgs=--cpus=1
PodmanArgs=--memory=512m
PodmanArgs=--memory-reservation=16m

LogDriver=journald

HealthCmd=["tuwunel", "--config", "/etc/tuwunel/config.toml", "--health-check"]
HealthStartPeriod=30s
HealthInterval=60s
HealthTimeout=15s
HealthRetries=3

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
