[Unit]
Description=VictoriaMetrics (Logs) container service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
Image=docker.io/victoriametrics/victoria-logs:v1.52.0

ContainerName=victoria-logs

Exec=-storageDataPath=/var/lib/victoria -retentionPeriod=91d

StopTimeout=10

EnvironmentFile=%h/.config/containers/systemd/victoria-logs.env

#User=0:0
Volume=victoria-logs_data.volume:/var/lib/victoria:Z

PublishPort=127.0.0.1:1180:9428

Network=10_26_0_1.network:ip=10.26.11.80

PodmanArgs=--cpus=4
PodmanArgs=--memory=4g
PodmanArgs=--memory-reservation=64m

LogDriver=journald

#HealthCmd=wget --no-verbose --tries=1 --spider http://127.0.0.1:9428/health
HealthCmd=["./victoria-logs-prod", "-version"]
#HealthStartPeriod=10s
HealthInterval=600s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
