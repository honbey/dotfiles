[Unit]
Description=Code Server container service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
# Image=docker.io/codercom/code-server:latest
Image=docker.cnb.cool/honbey/cnb-dev-env:latest

ContainerName=code-server

Exec=--auth=none --proxy-domain=code-{{port}}.freewisdom.cn:33

#StopSignal=SIGINT
StopTimeout=10

EnvironmentFile=%h/.config/containers/systemd/code-server.env

#Tmpfs=/tmp:rw,size=2g,mode=1777
# caches or unimportant files in HDD
Volume=/opt/data/cache/code-server/tmp:/tmp:Z
Volume=/opt/data/cache/code-server/share:/share:Z
Volume=/opt/data/cache/code-server/cache:/root/.cache:Z
Volume=/opt/data/cache/code-server/cache-linuxbrew:/home/linuxbrew/.cache:Z
Volume=/opt/data/cache/code-server/npm:/root/.npm:Z
# entrypointd, configs, data
Volume=./code-server.conf.d/entrypoint.d/:/entrypoint.d:Z
Volume=./code-server.conf.d/sync/snippets:/root/.local/share/code-server/User/snippets:Z
Volume=./code-server.conf.d/sync/settings.json:/root/.local/share/code-server/User/settings.json:Z
Volume=./code-server.conf.d/sync/keybindings.json:/root/.local/share/code-server/User/keybindings.json:Z
Volume=./code-server.conf.d/sync/.zsh_history:/root/.zsh_history:Z
Volume=./code-server.conf.d/sync/.local.zsh:/root/.local.zsh:Z
Volume=./code-server.conf.d/sync/zoxide:/root/.local/share/zoxide:Z
Volume=code-server_data.volume:/root/workspace:Z

PublishPort=127.0.0.1:1040:8686

Network=10_26_0_1.network:ip=10.26.10.40

# Memory=12G
PodmanArgs=--cpus=6
PodmanArgs=--memory=12g
PodmanArgs=--memory-reservation=128m

LogDriver=journald

HealthCmd=curl -fsS http://localhost:8686/healthz
HealthStartPeriod=10s
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
RestartSec=10s
ExecStartPre=mkdir -p %h/.config/containers/systemd/code-server.conf.d/sync/snippets
ExecStartPre=touch %h/.config/containers/systemd/code-server.conf.d/sync/settings.json
ExecStartPre=touch %h/.config/containers/systemd/code-server.conf.d/sync/keybindings.json
ExecStartPre=touch %h/.config/containers/systemd/code-server.conf.d/sync/.zsh_history
ExecStartPre=touch %h/.config/containers/systemd/code-server.conf.d/sync/.local.zsh
ExecStartPre=mkdir -p %h/.config/containers/systemd/code-server.conf.d/sync/zoxide

[Install]
WantedBy=default.target
