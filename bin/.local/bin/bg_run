#!/usr/bin/env bash
set -euo pipefail

# Colors for output (matching the style of the root install.sh)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

PID_DIR="."
FORCE=false
ACTION=""

function info() { echo -e "${GREEN}[INFO]${NC}  $*"; }
function warn() { echo -e "${YELLOW}[WARN]${NC}  $*"; }
function err() { echo -e "${RED}[ERROR]${NC} $*"; }
function step() { echo -e "${CYAN}[STEP]${NC}  $*"; }

function usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] <program> [args...]

Run a program in the background; write its PID to <pid-dir>/<program>.pid and
append its output to a timestamped log <pid-dir>/<program>-<ts>.log.

Options may be written before or after <program>. After it, only --pid-dir,
--force, --signal and "-s stop|reload" are read as this script's options, so a
program's own -f/-d/-h/-s flags pass through untouched; everything after "--"
goes to the program as well.

Options:
  -d DIR, --pid-dir DIR  Directory for the PID file and logs (default: current dir)
  -f, --force            Terminate a live old process first, then restart
                         (default: refuse to start if the old process is alive)
  -s ACTION, --signal ACTION
                         stop: send SIGTERM to the running process and exit
                         reload: send SIGHUP to the running process and exit
  -h, --help             Show this help
EOF
}

# Parse options in any position, keeping the program and its arguments in an
# array so that arguments containing spaces (e.g. `bash -c '...'`) survive.
# Only the long forms plus "-s stop|reload" are read after <program>, otherwise
# a program's own -f/-d/-h/-s would be swallowed silently; "--" ends option
# parsing, so everything after it reaches the program untouched.
PROGRAM=()
program_seen=false
options_ended=false

# Guard a trailing option that expects a value.
function need_value() {
  if [[ "$2" -lt 2 ]]; then
    err "option $1 needs a value"
    usage
    exit 1
  fi
}

while [[ $# -gt 0 ]]; do
  token="$1"

  if ${options_ended}; then
    PROGRAM+=("${token}")
    shift
    continue
  fi

  if ${program_seen}; then
    case "${token}" in
    --pid-dir=*) PID_DIR="${token#*=}" ;;
    --pid-dir)
      need_value "${token}" $#
      PID_DIR="$2"
      shift
      ;;
    --force) FORCE=true ;;
    --signal=*) ACTION="${token#*=}" ;;
    --signal)
      need_value "${token}" $#
      ACTION="$2"
      shift
      ;;
    -s)
      if [[ "${2:-}" == "stop" || "${2:-}" == "reload" ]]; then
        ACTION="$2"
        shift
      else
        PROGRAM+=("${token}")
      fi
      ;;
    *) PROGRAM+=("${token}") ;;
    esac
    shift
    continue
  fi

  case "${token}" in
  --pid-dir=*) PID_DIR="${token#*=}" ;;
  --pid-dir)
    need_value "${token}" $#
    PID_DIR="$2"
    shift
    ;;
  --force) FORCE=true ;;
  --signal=*) ACTION="${token#*=}" ;;
  --signal)
    need_value "${token}" $#
    ACTION="$2"
    shift
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  --) options_ended=true ;;
  -d?*) PID_DIR="${token#-d}" ;;
  -d)
    need_value "${token}" $#
    PID_DIR="$2"
    shift
    ;;
  -f) FORCE=true ;;
  -s?*) ACTION="${token#-s}" ;;
  -s)
    need_value "${token}" $#
    ACTION="$2"
    shift
    ;;
  -*)
    err "unknown option: ${token}"
    usage
    exit 1
    ;;
  *)
    PROGRAM=("${token}")
    program_seen=true
    ;;
  esac
  shift
done

if [[ ${#PROGRAM[@]} -eq 0 ]]; then
  err "no program given"
  usage
  exit 1
fi
set -- "${PROGRAM[@]}"

# Expand a leading ~ so that --pid-dir=~/logs works
PID_DIR="${PID_DIR/#\~/$HOME}"

PROGRAM_BASENAME="$(basename "$1")"
PID_FILE="${PID_DIR}/${PROGRAM_BASENAME}.pid"

# Read the pid file and validate its content (digits only, guards against a
# corrupted file being fed to kill).
function read_pid() {
  local content
  [[ -f "${PID_FILE}" ]] || return 1
  content="$(<"${PID_FILE}")"
  [[ "${content}" =~ ^[0-9]+$ ]] || return 1
  echo "${content}"
}

# Check whether the recorded process is alive and really is our program. Every
# cmdline element is compared by basename, never as a substring, so short names
# cannot false-match (e.g. "sh" inside "bash") and PID reuse stays safe. argv[0]
# alone is not enough: for a shebang script the kernel stores the interpreter
# there and passes the script as an argument ("bash /path/to/svc.sh"), so the
# script would look like a foreign process and get killed as "not running".
function is_running() {
  local pid="$1" element
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  [[ -r "/proc/${pid}/cmdline" ]] || return 1
  while IFS= read -r element; do
    [[ -n "${element}" ]] || continue
    if [[ "$(basename "${element}")" == "${PROGRAM_BASENAME}" ]]; then
      return 0
    fi
  done < <(tr '\0' '\n' <"/proc/${pid}/cmdline")
  return 1
}

function send_signal() {
  local signal="$1" pid
  pid="$(read_pid)" || {
    err "no valid pid file: ${PID_FILE}"
    exit 1
  }
  if ! is_running "${pid}"; then
    err "process ${pid} is not running (or does not match ${PROGRAM_BASENAME})"
    exit 1
  fi
  kill "-${signal}" "${pid}"
  info "sent ${signal} to ${pid} (${PROGRAM_BASENAME})"
}

# After stop: wait for the process to exit (signals are asynchronous) and only
# then drop the pid file, so a quick start cannot spawn a second instance.
# Keep the file on timeout; the stale-pid path handles it on the next run.
function wait_exit_and_clean() {
  local pid="$1"
  for _ in {1..20}; do
    kill -0 "${pid}" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "${pid}" 2>/dev/null; then
    warn "process ${pid} has not exited yet; keeping ${PID_FILE}"
  else
    rm -f "${PID_FILE}"
  fi
}

if [[ -n "${ACTION}" ]]; then
  case "${ACTION}" in
  stop)
    send_signal TERM
    wait_exit_and_clean "$(read_pid)"
    ;;
  reload) send_signal HUP ;;
  *)
    err "invalid --signal: ${ACTION} (expected stop or reload)"
    exit 1
    ;;
  esac
  exit 0
fi

if ! command -v "$1" >/dev/null 2>&1 && [[ ! -x "$1" ]]; then
  err "${1} is not executable or not found on PATH"
  exit 1
fi

# Refuse to start when the old process is still alive, unless forced.
OLD_PID="$(read_pid || true)"
if [[ -n "${OLD_PID}" ]]; then
  if is_running "${OLD_PID}"; then
    if ${FORCE}; then
      warn "terminating old process ${OLD_PID}"
      kill -TERM "${OLD_PID}"
      for _ in {1..10}; do
        kill -0 "${OLD_PID}" 2>/dev/null || break
        sleep 0.1
      done
      if kill -0 "${OLD_PID}" 2>/dev/null; then
        warn "old process ${OLD_PID} still alive; sending SIGKILL"
        kill -KILL "${OLD_PID}"
      fi
    else
      err "process ${OLD_PID} is already running; use -f to force a restart"
      exit 1
    fi
  else
    warn "stale pid file detected; ignoring it"
  fi
fi

mkdir -p "${PID_DIR}"
LOG_FILE="${PID_DIR}/${PROGRAM_BASENAME}-$(date +%Y%m%d-%H%M%S).log"

# Detach into a new session so the process survives shell exit, but keep
# signals intact (nohup would ignore SIGHUP and break the reload action).
setsid "$@" >>"${LOG_FILE}" 2>&1 &
NEW_PID=$!
echo "${NEW_PID}" >"${PID_FILE}"

# Fail fast when the program dies immediately (bad arguments, missing files...):
# drop the pid file and show the log tail to ease debugging.
sleep 0.3
if ! is_running "${NEW_PID}"; then
  rm -f "${PID_FILE}"
  err "${PROGRAM_BASENAME} exited right after start; last log lines:"
  tail -n 5 "${LOG_FILE}" >&2 || true
  exit 1
fi

info "${PROGRAM_BASENAME} started with pid ${NEW_PID}"
info "pid file: ${PID_FILE}"
info "log file: ${LOG_FILE}"
