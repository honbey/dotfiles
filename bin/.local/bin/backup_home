#!/usr/bin/env bash
set -euo pipefail

# Colors for output (matching the style of the root install.sh)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

function info() { echo -e "${GREEN}[INFO]${NC}  $*"; }
function warn() { echo -e "${YELLOW}[WARN]${NC}  $*"; }
function err() { echo -e "${RED}[ERROR]${NC} $*"; }
function step() { echo -e "${CYAN}[STEP]${NC}  $*"; }

function usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Backup the home directory: pack selected paths with tar, then compress
with 7zz (fallback: 7z) into an encrypted 7z archive.

Uses GNU tar incremental mode (-g/--listed-incremental): the first run
(-f) creates a full backup and a snapshot; later runs only pack changes.

Output file names:
  home_<user>-<machine-id8>-<date>.tar   (raw tar archive)
  home_<user>-<machine-id8>-<date>.7z    (encrypted 7z archive, or .7z.001/.002/... when split)
  home_<user>-<machine-id8>.snap         (snapshot, updated each run)
  home_<user>-<machine-id8>-<date>.snap  (snapshot copy for restore)

Options:
  -f, --first-run           Initial full backup (creates the snapshot)
  -o DIR, --output-dir DIR  Output directory (default: .)
  -l N, --mx-level N        7z compression level 0-9 (default: 1)
  -s SIZE, --split-size SIZE
                            7z volume size with unit b/k/m/g (e.g. 4g, 512m);
                            --split-size alone defaults to 20g; off by default
  -h, --help                Show this help

Requires 7zz or 7z on PATH. Run from the home directory.

Restore (in order, oldest first; extract each .7z first):
  tar --listed-incremental=<date>.snap -xf <date>.tar
  # split archive: 7zz x <date>.7z.001  (reads all volumes)

Examples:
  $(basename "$0") -f                      # first full backup
  $(basename "$0")                         # incremental backup
  $(basename "$0") -o /backup -l 5         # output dir + mx level 5
  $(basename "$0") -s 4g                   # split into 4G volumes
EOF
}

OUT_DIR="."
MX_LEVEL=1
FIRST_RUN=false
SPLIT_SIZE=""

# Paths to back up, relative to $HOME (one per line, easy to extend)
TAR_PATHS=(
  .backup_excluded .backup_metadata
  .env .ssh .sqliterc .startup .stow-global-ignore .gnupg .graveyard
  .cargo .npmrc .config/pip .config/uv
  .gitconfig .local.gitconfig
  .vim .vimrc
  .config/nvim .local/share/nvim .local/state/nvim
  .zsh .zsh_history .zshenv .zshrc .local.zsh .local/share/zinit
  .config/containers .config/ghostty .config/tmux
  .local/share/zoxide
  Downloads app data dotfiles kb resources workspace
)

# Map long options to short ones before getopts.
# Use printf instead of echo: a bare "-n" would be swallowed by echo.
# --split-size peeks the next arg: a size value is consumed, otherwise
# the default 20g applies (explicit -s SIZE also works).
set -- $(
  args=("$@")
  for ((i = 0; i < ${#args[@]}; i++)); do
    arg="${args[i]}"
    case "${arg}" in
    --help) printf '%s\n' "-h" ;;
    --first-run) printf '%s\n' "-f" ;;
    --output-dir=*) printf '%s\n' "-o ${arg#*=}" ;;
    --output-dir) printf '%s\n' "-o" ;;
    --mx-level=*) printf '%s\n' "-l ${arg#*=}" ;;
    --mx-level) printf '%s\n' "-l" ;;
    --split-size=*) printf '%s\n' "-s ${arg#*=}" ;;
    --split-size)
      if ((i + 1 < ${#args[@]})) && [[ "${args[i + 1]}" =~ ^[1-9][0-9]*[bkmg]?$ ]]; then
        printf '%s\n' "-s ${args[i + 1]}"
        ((i++))
      else
        printf '%s\n' "-s 20g"
      fi
      ;;
    *) printf '%s\n' "${arg}" ;;
    esac
  done
)

while getopts "ho:l:fs:" opt; do
  case "${opt}" in
  h) usage; exit 0 ;;
  f) FIRST_RUN=true ;;
  o) OUT_DIR="${OPTARG}" ;;
  l) MX_LEVEL="${OPTARG}" ;;
  s) SPLIT_SIZE="${OPTARG}" ;;
  *) usage; exit 1 ;;
  esac
done

if ! [[ "${MX_LEVEL}" =~ ^[0-9]+$ ]] || [[ "${MX_LEVEL}" -gt 9 ]]; then
  err "invalid --mx-level: ${MX_LEVEL} (expected an integer 0-9)"
  exit 1
fi

if [[ -n "${SPLIT_SIZE}" ]] && ! [[ "${SPLIT_SIZE}" =~ ^[1-9][0-9]*[bkmg]?$ ]]; then
  err "invalid --split-size: ${SPLIT_SIZE} (expected e.g. 4g, 512m, 1k)"
  exit 1
fi

OUT_DIR="${OUT_DIR/#\~/$HOME}"
mkdir -p "${OUT_DIR}"

# Prefer 7zz, fall back to 7z; abort early if neither is available.
SEVENZIP=""
if command -v 7zz >/dev/null 2>&1; then
  SEVENZIP="7zz"
elif command -v 7z >/dev/null 2>&1; then
  SEVENZIP="7z"
else
  err "neither 7zz nor 7z found on PATH; install p7zip first"
  exit 1
fi

# machine id: first 8 chars of the /etc/machine-id line in ~/.backup_metadata
MACHINE_ID="$(awk -F': ' '/\/etc\/machine-id:/{print $2}' ~/.backup_metadata | cut -c1-8)"
if [[ -z "${MACHINE_ID}" ]]; then
  err "cannot read machine id from ~/.backup_metadata"
  exit 1
fi

USER_NAME="$(id -un)"
DATE="$(date +%Y%m%d)"
BASE="home_${USER_NAME}-${MACHINE_ID}-${DATE}"
TAR_FILE="${OUT_DIR}/${BASE}.tar"
SEVENZIP_FILE="${OUT_DIR}/${BASE}.7z"
SNAP="${OUT_DIR}/home_${USER_NAME}-${MACHINE_ID}.snap"
SNAP_COPY="${OUT_DIR}/${BASE}.snap"

# Snapshot gates: -f requires no existing snapshot; incremental mode
# requires one. A same-day rerun would overwrite the archive, so warn.
if ${FIRST_RUN}; then
  if [[ -e "${SNAP}" ]]; then
    err "snapshot ${SNAP} already exists; delete it first to force a fresh full backup"
    exit 1
  fi
else
  if [[ ! -e "${SNAP}" ]]; then
    err "no snapshot found; run with -f for the initial full backup"
    exit 1
  fi
fi
if [[ -e "${TAR_FILE}" ]]; then
  warn "archive ${TAR_FILE} already exists; same-day rerun overwrites it (keep the -f backup for restore)"
fi

step "Packing home directory to ${TAR_FILE}"

# Validate paths first; warn about missing ones instead of letting tar fail midway.
VALID_PATHS=()
for p in "${TAR_PATHS[@]}"; do
  if [[ -e "${HOME}/${p}" ]]; then
    VALID_PATHS+=("${p}")
  else
    warn "skipping missing path: ${p}"
  fi
done

tar cf "${TAR_FILE}" \
  -C ~ \
  -g "${SNAP}" \
  --exclude-from=.backup_excluded \
  "${VALID_PATHS[@]}"

# Keep a snapshot copy next to the archive so it can be restored later.
cp "${SNAP}" "${SNAP_COPY}"

step "Compressing ${TAR_FILE} to ${SEVENZIP_FILE} (mx=${MX_LEVEL}${SPLIT_SIZE:+, split ${SPLIT_SIZE}})"
if [[ -n "${SPLIT_SIZE}" ]]; then
  "${SEVENZIP}" a -t7z -mhe=on -p -mx="${MX_LEVEL}" -v"${SPLIT_SIZE}" "${SEVENZIP_FILE}" "${TAR_FILE}"
  info "backup done: ${SEVENZIP_FILE}.001 (+ $(ls "${SEVENZIP_FILE}".0* 2>/dev/null | wc -l) volumes)"
else
  "${SEVENZIP}" a -t7z -mhe=on -p -mx="${MX_LEVEL}" "${SEVENZIP_FILE}" "${TAR_FILE}"
  info "backup done: ${SEVENZIP_FILE}"
fi
